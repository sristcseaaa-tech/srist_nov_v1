# Content DB — homepage/customize data
MONGODB_URI=mongodb://127.0.0.1:27017/srist
# Auth DB — user accounts (can be the same cluster, different db name, or a fully separate cluster)
AUTH_MONGODB_URI=mongodb://127.0.0.1:27017/srist-auth
# Student sign-up DB — one record per student sign-up form submission
STUDENT_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
# STUDENT_DB_NAME=srist-students
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-string

BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@example.com

GOOGLE_SHEET_ID=1UNNLeyFqfyEnFHfZSYbxS22DZpUcNag0CdaQqTOjHXY
# Tab (worksheet) inside that spreadsheet. Created automatically if missing.
# NOTE: a new spreadsheet opens on a tab called "Sheet1" — rows go into the
# "Applications" tab (look at the tab strip at the bottom), unless you set
# this to Sheet1 to fill the first tab instead.
GOOGLE_SHEET_TAB=Applications

CLOUDINARY_WEBSITE_URL=cloudinary://<api_key>:<api_secret>@<website_cloud_name>
# Account 2 — STUDENT + ASSESSMENT media (private, "authenticated"): student photos, assessment files, student documents.
CLOUDINARY_STUDENT_URL=cloudinary://<api_key>:<api_secret>@<student_cloud_name>

SUPABASE_URL=<supabase-url>
SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
SUPABASE_SECRET_KEY=<supabase-secret-key>
SUPABASE_JWKS_URL=<supabase-jwks-url>
# Private bucket (created automatically on first start) and the biggest file accepted (Supabase free plan: 50 MB).
SUPABASE_BUCKET=srist-files
FILE_MAX_MB=50
# Public address of THIS API (no trailing slash). Render sets RENDER_EXTERNAL_URL itself; elsewhere set it.
# PUBLIC_API_URL=https://your-api.example.com
